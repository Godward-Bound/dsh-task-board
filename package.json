{
    "name":  "dsh-task-board",
    "version":  "0.2.0",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "license":  "MIT",
    "description":  "Task board for DSH: one call lists every task card in the workspace - which never started, which is running, which finished, which is stuck. Read-only, zero dependencies.",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Godward-Bound/dsh-task-board.git"
                   },
    "homepage":  "https://github.com/Godward-Bound/dsh-task-board#readme",
    "keywords":  [
                     "dsh-plugin",
                     "deepseek-harness",
                     "task-board",
                     "kanban",
                     "markdown"
                 ],
    "engines":  {
                    "node":  ">=18.15.0"
                },
    "files":  [
                  "index.js",
                  "lib/*.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "docs",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ]
}
